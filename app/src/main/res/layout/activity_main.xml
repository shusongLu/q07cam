<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101418"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFEDEDED"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvPlugin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/plugin_loading"
            android:textColor="#FF9AA0A6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="0.0 kW"
            android:textColor="#FF8AE234"
            android:textSize="60sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFCE94F"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvSoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FF9AA0A6"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTurn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FF729FCF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvRaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="14dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/displays_title"
            android:textColor="#FFEDEDED"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDisplays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="#FF9AA0A6"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnReloadPlugin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/btn_reload_plugin" />

        <Button
            android:id="@+id/btnRefreshDisplays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_refresh_displays" />

        <Button
            android:id="@+id/btnPresentation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_presentation" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_overlay" />

    </LinearLayout>
</ScrollView>
